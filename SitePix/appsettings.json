// Default SitePix profile — ships tuned for kadampa.org/news so existing
// users get the same behavior as before the refactor. Swap this file, or
// pass a different one on the command line:
//     sitepix samples/petapixel.json
{
  "StartPage": "https://kadampa.org/news",

  "Policies": {
    "LinkDepth": 7,
    "RetentionDays": 7
  },

  "Scraper": {
    // {Year} is substituted with the current 4-digit year at runtime.
    "UrlPattern": "/{Year}/",
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [
      "150x",
      "whatsapp-image",
      "paperback",
      "book",
      "gen-",
      "1024x",
      "adobestock",
      "heic_"
    ],
    "ContentSelectors": [
      "main article .entry-content",
      "article .entry-content",
      "main article",
      "article",
      "body"
    ]
  },

  "Task Scheduler": {
    "StartTime": "05:30"
  },

  "Directories": {
    "UseMyPictures": false,
    "PhotoText": true,
    "SubDirectory": "SitePix",
    "Base": "d:/temp/"
  },

  "PhotoText": {
    "Font": "Palatino Linotype",
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "BrandColors": [
      "#224486",
      "#A99886",
      "#66B9C4",
      "#358DCB",
      "#BE303C",
      "#48ADF4"
    ]
  },

  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
