{
  // Default profile: Met Museum Open Access. ~half a million CC0 works, no API
  // key required. Each item ships rich metadata (artist, date, medium) for the
  // subtitle, and titles vary widely from artwork to artwork — perfect for a
  // soft initial pull. Switch to a different sample under /samples for other
  // catalogs (Smithsonian, NASA, Library of Congress, Flickr Commons, NYPL).

  "Source": {
    "Provider": "metmuseum",

    // Optional. Leave empty for "anything"; set to e.g. "landscape", "Japan",
    // "Egypt" to bias toward a theme. Multiple words are AND-ed by Met.
    "Query": "",

    // When true, restricts to the Met's curated highlights (~2,000 objects).
    // Off by default — the whole open-access pool is more varied.
    "OnlyHighlights": false,

    // Most Met objects also expose `additionalImages[]` (alternate views,
    // back of canvas, conservation shots). 1 = primary only.
    "MaxImagesPerItem": 1
  },

  // Informational — not used in API mode, but kept so existing tooling/UI
  // that reads StartPage shows where the images come from.
  "StartPage": "https://www.metmuseum.org/art/collection",

  "Policies": {
    // API mode treats LinkDepth as "items to download per run". Each Met item
    // yields one image by default, so this is also the rough image count.
    "LinkDepth": 20,
    "RetentionDays": 7
  },

  "Scraper": {
    // MinWidthPx still applies to API downloads — Met serves originals well
    // above 1024 px, so anything smaller is almost certainly a thumbnail.
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [],

    // Pacing between successive item-detail fetches. Met's public API is
    // generous but a small delay keeps us a good citizen.
    "RequestDelayMs": 500
  },

  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-Met"
  },

  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "MetMuseum",
    "PhotoText": true
  },

  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "PanelOpacity": 210,
    "BrandColors": [
      "#E4002B",
      "#1A1A1A",
      "#FFFFFF",
      "#A07C44"
    ]
  },

  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
