{
  // Default profile: Met Museum Open Access. ~half a million CC0 works, no
  // API key required.
  //
  // RIGHTS — chosen as the default because every image returned by this
  // search has been released by the Met under Creative Commons Zero (CC0).
  // CC0 is a full waiver of copyright; the resulting images (and your
  // overlays of them) can be reposted, modified, and reused without
  // attribution or permission. There is no per-item rights review needed.
  // Reference: https://www.metmuseum.org/about-the-met/policies-and-documents/open-access
  //
  // The only other supported API source is Smithsonian (samples/si.edu.json),
  // also CC0. Other catalogs (NASA, LoC, Flickr Commons, NYPL) were
  // intentionally excluded — see SitePix/ApiSources.cs for why.

  "Source": {
    "Provider": "metmuseum",

    // Optional. Leave empty for "anything"; set to e.g. "landscape", "Japan",
    // "Egypt" to bias toward a theme. Multiple words are AND-ed by Met.
    "Query": "",

    // When true, restricts to the Met's curated highlights (~2,000 objects).
    // Off by default — the whole open-access pool is more varied.
    "OnlyHighlights": false,

    // Most Met objects also expose `additionalImages[]` (alternate views,
    // back of canvas, conservation shots). 1 = primary only.
    "MaxImagesPerItem": 1
  },

  // Informational — not used in API mode, but kept so existing tooling/UI
  // that reads StartPage shows where the images come from.
  "StartPage": "https://www.metmuseum.org/art/collection",

  "Policies": {
    // API mode treats LinkDepth as "items to download per run". Each Met item
    // yields one image by default, so this is also the rough image count.
    "LinkDepth": 20,
    "RetentionDays": 7
  },

  "Scraper": {
    // MinWidthPx still applies to API downloads — Met serves originals well
    // above 1024 px, so anything smaller is almost certainly a thumbnail.
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [],

    // Pacing between successive item-detail fetches. Met's public API is
    // generous but a small delay keeps us a good citizen.
    "RequestDelayMs": 500
  },

  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-Met"
  },

  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "MetMuseum",
    "PhotoText": true
  },

  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "PanelOpacity": 210,
    "BrandColors": [
      "#E4002B",
      "#1A1A1A",
      "#FFFFFF",
      "#A07C44"
    ]
  },

  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
