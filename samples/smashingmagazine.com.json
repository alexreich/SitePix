{
  "StartPage": "https://www.smashingmagazine.com/",

  "Policies": {
    "LinkDepth": 5,
    "RetentionDays": 7
  },

  "Scraper": {
    "_comment_UrlPattern": "Smashing uses /YYYY/MM/<slug>/ permalinks (no day component).",
    "UrlPattern": "/{Year}/\\d{2}/[a-z0-9-]+/?$",
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [
      "thumb",
      "150x",
      "300x",
      "avatar",
      "gravatar",
      "logo",
      "icon",
      "sponsor"
    ],
    "ContentSelectors": [
      "main article .article__content",
      "main article .entry-content",
      "article .article__content",
      "main article",
      "article",
      "body"
    ]
  },

  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-Smashing"
  },

  "Directories": {
    "UseMyPictures": true,
    "PhotoText": true,
    "SubDirectory": "SmashingMagazine"
  },

  "PhotoText": {
    "Font": "Helvetica Neue",
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "BrandColors": [
      "#D33C47",
      "#1A1A1A",
      "#FFFFFF",
      "#3F4E58"
    ]
  }
}
