{
  "Source": {
    "Provider": "flickrcommons",
    "ApiKey": "",
    "ApiKeyEnv": "FLICKR_API_KEY",
    "Query": ""
  },
  "StartPage": "https://www.flickr.com/commons",
  "Policies": {
    "LinkDepth": 20,
    "RetentionDays": 7
  },
  "Scraper": {
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [],
    "RequestDelayMs": 500
  },
  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-FlickrCommons"
  },
  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "FlickrCommons",
    "PhotoText": true
  },
  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "PanelOpacity": 210,
    "BrandColors": [
      "#FF0084",
      "#0063DC",
      "#FFFFFF",
      "#1A1A1A"
    ]
  },
  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
