{
  // NYPL Digital Collections. Requires a free API token.
  //
  // Get a token: https://api.repo.nypl.org/ (sign up; token is mailed)
  // API docs:    http://api.repo.nypl.org/
  //
  // Set the token via Source:ApiKey (it's the value sent in the
  // `Authorization: Token token="..."` header) or Source:ApiKeyEnv.

  "Source": {
    "Provider": "nypl",

    "ApiKey": "",
    "ApiKeyEnv": "NYPL_API_TOKEN",

    // Free-text query. "*" = anything in the public-domain pool.
    "Query": "*"
  },

  "StartPage": "https://digitalcollections.nypl.org/",

  "Policies": {
    "LinkDepth": 20,
    "RetentionDays": 7
  },

  "Scraper": {
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [],
    "RequestDelayMs": 500
  },

  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-NYPL"
  },

  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "NYPL",
    "PhotoText": true
  },

  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "PanelOpacity": 210,
    "BrandColors": [
      "#CE0E2D",
      "#1F1F1F",
      "#FFFFFF",
      "#7E7E7E"
    ]
  },

  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
