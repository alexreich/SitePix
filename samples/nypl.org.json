{
  "Source": {
    "Provider": "nypl",
    "ApiKey": "",
    "ApiKeyEnv": "NYPL_API_TOKEN",
    "Query": "*"
  },
  "StartPage": "https://digitalcollections.nypl.org/",
  "Policies": {
    "LinkDepth": 20,
    "RetentionDays": 7
  },
  "Scraper": {
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [],
    "RequestDelayMs": 500
  },
  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-NYPL"
  },
  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "NYPL",
    "PhotoText": true
  },
  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "PanelOpacity": 210,
    "BrandColors": [
      "#CE0E2D",
      "#1F1F1F",
      "#FFFFFF",
      "#7E7E7E"
    ]
  },
  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
