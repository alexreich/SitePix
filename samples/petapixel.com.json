{
  "StartPage": "https://petapixel.com/",
  "Policies": {
    "LinkDepth": 5,
    "RetentionDays": 7
  },
  "Scraper": {
    "UrlPattern": "/{Year}/\\d{2}/\\d{2}/",
    "MinWidthPx": 1200,
    "ImageUrlExcludes": [
      "-150x",
      "-300x",
      "-768x",
      "avatar",
      "gravatar",
      "logo",
      "icon",
      "sprite",
      "/emoji/",
      "/plugins/",
      "/themes/",
      "mailchimp",
      "newsletter",
      "sponsor",
      "/ads/",
      "doubleclick",
      "googletagmanager",
      "googlesyndication"
    ],
    "ContentSelectors": [
      "main article .entry-content",
      "article .entry-content",
      "main article",
      "article",
      ".post-content",
      "body"
    ],
    "ContentExcludeSelectors": [
      ".related-posts",
      ".jp-relatedposts",
      ".yarpp-related",
      ".related-articles",
      ".more-from",
      ".newsletter",
      ".newsletter-signup",
      ".email-signup",
      ".mc-signup",
      ".mailchimp",
      ".sharedaddy",
      ".share-buttons",
      ".social-share",
      ".author-bio",
      ".author-info",
      ".byline-author",
      ".comments",
      "#comments",
      ".advertisement",
      ".ad",
      ".ad-container",
      ".adsbygoogle",
      ".promo",
      ".sponsored",
      ".sponsor",
      ".wp-embed",
      "aside",
      "[role=complementary]"
    ],
    "SameOriginOnly": true
  },
  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-PetaPixel"
  },
  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "PetaPixel",
    "PhotoText": true
  },
  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    "PanelOpacity": 210,
    "BrandColors": [
      "#111111",
      "#FFFFFF",
      "#E30613",
      "#F5A623",
      "#4A90E2"
    ]
  },
  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
