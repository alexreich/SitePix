{
  "StartPage": "https://kadampa.org/news",

  "Policies": {
    "LinkDepth": 7,
    "RetentionDays": 7
  },

  "Scraper": {
    "UrlPattern": "/{Year}/",
    "MinWidthPx": 1024,
    "ImageUrlExcludes": [
      "150x",
      "whatsapp-image",
      "paperback",
      "book",
      "gen-",
      "1024x",
      "adobestock",
      "heic_"
    ],
    "ContentSelectors": [
      "main article .entry-content",
      "article .entry-content",
      "main article",
      "article",
      "body"
    ]
  },

  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-Kadampa"
  },

  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "Kadampa",
    "PhotoText": true
  },

  "PhotoText": {
    "Font": "Palatino",
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    // Overlay mode for readability:
    // -1 = no panel and no outline, 0 = outline only, 1..255 = panel opacity.
    "PanelOpacity": 210,
    "BrandColors": [
      "#224486",
      "#A99886",
      "#66B9C4",
      "#358DCB",
      "#BE303C",
      "#48ADF4"
    ]
  },

  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
