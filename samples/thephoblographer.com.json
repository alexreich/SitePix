{
  "StartPage": "https://www.thephoblographer.com/",

  "Policies": {
    "LinkDepth": 6,
    "RetentionDays": 7
  },

  "Scraper": {
    "UrlPattern": "/{Year}/\\d{2}/\\d{2}/",
    "MinWidthPx": 1200,
    "ImageUrlExcludes": [
      "150x",
      "300x",
      "avatar",
      "gravatar",
      "logo",
      "icon",
      "ad-",
      "sponsor"
    ],
    "ContentSelectors": [
      "main article .entry-content",
      "article .entry-content",
      "main article",
      "article",
      "body"
    ]
  },

  "Task Scheduler": {
    "StartTime": "",
    "Id": "SitePix-Phoblographer"
  },

  "Directories": {
    "UseMyPictures": true,
    "Base": "",
    "SubDirectory": "ThePhoblographer",
    "PhotoText": true
  },

  "PhotoText": {
    "Font": "Helvetica Neue",
    "TitleFontScale": 1.0,
    "SubtitleFontScale": 1.0,
    "DateInclude": true,
    "DateFormat": "MM/dd",
    "DatePrefix": " - ",
    "ImageFileName": false,
    // Overlay mode for readability:
    // -1 = no panel and no outline, 0 = outline only, 1..255 = panel opacity.
    "PanelOpacity": 210,
    "BrandColors": [
      "#1A1A1A",
      "#FFFFFF",
      "#E74C3C",
      "#3498DB"
    ]
  },

  "LogLevel": {
    "Default": "Information",
    "Microsoft": "Warning",
    "System": "Warning"
  }
}
