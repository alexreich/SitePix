#!/bin/sh
# Installs (or uninstalls) a daily schedule for SitePix.
#
# On macOS:  writes ~/Library/LaunchAgents/com.alexreich.sitepix.plist
#            and loads it via launchctl.
# On Linux:  if systemd --user is available, writes a .service + .timer under
#            ~/.config/systemd/user/ and enables them. Otherwise falls back to
#            adding a crontab line.
#
# Usage: sitepix-install-schedule [--uninstall] [--time HH:MM]
set -eu

TIME="05:30"
UNINSTALL=0

while [ $# -gt 0 ]; do
  case "$1" in
    --uninstall) UNINSTALL=1; shift ;;
    --time)      TIME="${2:-}"; shift 2 ;;
    -h|--help)
      sed -n '2,12p' "$0"
      exit 0
      ;;
    *) echo "Unknown flag: $1" >&2; exit 2 ;;
  esac
done

HOUR="${TIME%%:*}"
MIN="${TIME##*:}"
case "$HOUR$MIN" in *[!0-9]*)
  echo "Invalid --time '$TIME'; expected HH:MM" >&2; exit 2 ;;
esac

# Locate the binary. Prefer what's on PATH, fall back to common install paths.
find_binary() {
  if command -v sitepix >/dev/null 2>&1; then
    command -v sitepix
    return
  fi
  for c in \
    /opt/sitepix/SitePix \
    /usr/local/bin/sitepix \
    "$HOME/.local/bin/sitepix" \
    "$(brew --prefix 2>/dev/null)/opt/sitepix/libexec/SitePix"
  do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
  done
  return 1
}

BIN="$(find_binary || true)"
if [ $UNINSTALL -eq 0 ] && [ -z "$BIN" ]; then
  echo "sitepix binary not found on PATH or common install paths." >&2
  echo "Install it first, or pass its full path: SITEPIX_BIN=/path/to/SitePix $0" >&2
  exit 1
fi
[ -n "${SITEPIX_BIN:-}" ] && BIN="$SITEPIX_BIN"

OS="$(uname -s)"

# --- macOS: launchd ----------------------------------------------------------
if [ "$OS" = "Darwin" ]; then
  PLIST_DIR="$HOME/Library/LaunchAgents"
  PLIST="$PLIST_DIR/com.alexreich.sitepix.plist"
  # TaskRegistration in the app writes com.sitepix.agent.plist on first run but
  # doesn't load it — we manage both so the user ends up with one active agent.
  LEGACY_PLIST="$PLIST_DIR/com.sitepix.agent.plist"

  if [ $UNINSTALL -eq 1 ]; then
    for p in "$PLIST" "$LEGACY_PLIST"; do
      if [ -f "$p" ]; then
        launchctl unload "$p" 2>/dev/null || true
        rm -f "$p"
        echo "Removed launchd agent: $p"
      fi
    done
    exit 0
  fi

  # Drop the app's unloaded plist if present so we don't end up with duplicates.
  if [ -f "$LEGACY_PLIST" ]; then
    launchctl unload "$LEGACY_PLIST" 2>/dev/null || true
    rm -f "$LEGACY_PLIST"
  fi

  mkdir -p "$PLIST_DIR"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.alexreich.sitepix</string>
  <key>ProgramArguments</key>
  <array>
    <string>$BIN</string>
  </array>
  <key>WorkingDirectory</key><string>$(dirname "$BIN")</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>$((10#$HOUR))</integer>
    <key>Minute</key><integer>$((10#$MIN))</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/SitePix.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/SitePix.log</string>
</dict>
</plist>
EOF
  launchctl unload "$PLIST" 2>/dev/null || true
  launchctl load   "$PLIST"
  echo "Installed launchd agent: $PLIST"
  echo "Daily run at $TIME. Logs: ~/Library/Logs/SitePix.log"
  exit 0
fi

# --- Linux: systemd user timer (preferred) -----------------------------------
if [ "$OS" = "Linux" ]; then
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    UNIT_DIR="$HOME/.config/systemd/user"
    SVC="$UNIT_DIR/sitepix.service"
    TIMER="$UNIT_DIR/sitepix.timer"

    if [ $UNINSTALL -eq 1 ]; then
      systemctl --user disable --now sitepix.timer 2>/dev/null || true
      rm -f "$SVC" "$TIMER"
      systemctl --user daemon-reload || true
      # Also clean any cron line the app's built-in TaskRegistration may have written.
      if command -v crontab >/dev/null 2>&1; then
        EXISTING="$(crontab -l 2>/dev/null || true)"
        CLEANED="$(printf '%s\n' "$EXISTING" | grep -v -F '# sitepix' | grep -v -F '# sitepix (managed by sitepix-install-schedule)' || true)"
        printf '%s\n' "$CLEANED" | crontab - 2>/dev/null || true
      fi
      echo "Removed systemd user units (and any leftover cron entries)."
      exit 0
    fi

    # When installing systemd, also remove any cron line the app's TaskRegistration
    # may have written on first run — single source of truth wins.
    if command -v crontab >/dev/null 2>&1; then
      EXISTING="$(crontab -l 2>/dev/null || true)"
      CLEANED="$(printf '%s\n' "$EXISTING" | grep -v -F '# sitepix' || true)"
      if [ "$EXISTING" != "$CLEANED" ]; then
        printf '%s\n' "$CLEANED" | crontab -
        echo "Removed app-installed cron entry; systemd timer takes over."
      fi
    fi

    mkdir -p "$UNIT_DIR"
    cat > "$SVC" <<EOF
[Unit]
Description=SitePix — download photos from configured news site
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=$BIN
WorkingDirectory=$(dirname "$BIN")
EOF
    cat > "$TIMER" <<EOF
[Unit]
Description=Daily SitePix sync

[Timer]
OnCalendar=*-*-* $TIME:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now sitepix.timer
    echo "Installed systemd user timer at $TIME daily."
    echo "Check with: systemctl --user list-timers sitepix.timer"
    exit 0
  fi

  # --- Linux fallback: crontab ---------------------------------------------
  if command -v crontab >/dev/null 2>&1; then
    TAG="# sitepix (managed by sitepix-install-schedule)"
    EXISTING="$(crontab -l 2>/dev/null || true)"
    # Strip both markers — ours, and the app's TaskRegistration default.
    CLEANED="$(printf '%s\n' "$EXISTING" | grep -v -F "$TAG" | grep -v -F '# sitepix' || true)"

    if [ $UNINSTALL -eq 1 ]; then
      printf '%s\n' "$CLEANED" | crontab -
      echo "Removed crontab entry."
      exit 0
    fi

    LINE="$MIN $HOUR * * * $BIN  $TAG"
    { printf '%s\n' "$CLEANED"; printf '%s\n' "$LINE"; } | crontab -
    echo "Installed crontab entry at $TIME daily."
    exit 0
  fi

  echo "Neither systemd --user nor crontab is available on this system." >&2
  echo "Add a scheduled job manually — the command to run is:" >&2
  echo "  $BIN" >&2
  exit 1
fi

echo "Unsupported OS: $OS" >&2
exit 1
