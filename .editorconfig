# https://editorconfig.org — keeps line endings, indent, and trailing
# whitespace consistent across editors / OSes / contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false  # markdown uses two-space line breaks
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.bat]
end_of_line = crlf
